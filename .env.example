# Discord Bot Configuration
BOT_TOKEN=your_bot_token_here

# Instabox API (from instabox.sh)
INSTABOX_API=your_instabox_api_key_here

# Gemini API (from aistudio.google.com)
GEMINI_API=your_gemini_api_key_here
# Optional; no owner ID is required. Discord discovers the application owner.
DB_URL=sqlite://database/db.sqlite3
INSTABOX_MACHINE_NAME=sus-link
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# Local daily budgets; verify your actual quotas in Google AI Studio.
GEMINI_DAILY_BUDGETS=20,20,500
